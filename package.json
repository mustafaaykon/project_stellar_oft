{
  "name": "oft-testkit",
  "version": "0.1.0",
  "description": "Local and testnet test harness for LayerZero-style OFT deployments on Stellar: mock endpoint, oftkit deploy/check/link/relay, 20-wallet simulation and a live dashboard.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "oftkit": "./bin/oftkit.mjs",
    "stellar-oftkit": "./bin/oftkit.mjs"
  },
  "scripts": {
    "contracts:test": "cargo test",
    "contracts:build": "stellar contract build",
    "oftkit": "node bin/oftkit.mjs",
    "sim": "node sim/run.mjs",
    "web:dev": "vite --config web/vite.config.mjs",
    "web:build": "vite build --config web/vite.config.mjs",
    "demo": "node demo/make-demo.mjs",
    "web:serve": "node web/serve.mjs",
    "web": "npm run web:build && node web/serve.mjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.0.0",
    "buffer": "^6.0.3",
    "commander": "^13.0.0",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.2.0",
    "playwright": "^1.50.0",
    "vite": "^6.0.0"
  }
}